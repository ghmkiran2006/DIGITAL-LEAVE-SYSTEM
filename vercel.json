{
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://digital-leave-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://digital-leave-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).* flare|.*)",
      "destination": "/index.html"
    }
  ]
}
